# Copy to .env and fill in values for local dev. NEVER commit .env.

# Anthropic — get key from https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_STRONG=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# Database — sqlite for local dev; switch to Neon Postgres URL in prod.
# Example Neon URL: postgresql+psycopg://user:pass@ep-xxx.neon.tech/bidiq?sslmode=require
DATABASE_URL=sqlite+pysqlite:///./bidiq.db

# CORS — add your deployed frontend domain in prod
# CORS_ORIGINS=["http://localhost:3000","https://ap-bidiq.vercel.app"]
